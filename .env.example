LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-me
LLM_MODEL_ID=deepseek-chat
LLM_TIMEOUT=120

LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL_ID=qwen3.6:35b
LOCAL_LLM_TIMEOUT=600

# bin/chat.php 的默认 profile；bin/00-05 可用 --profile 覆盖
LLM_PROFILE=cloud
CHAT_MAX_STEPS=12

APP_TIMEZONE=Asia/Shanghai
AGENT_TRACE=1
CONTEXT_TOKEN_BUDGET=12000
MAX_OLD_TOOL_CHARS=1200
SUBAGENT_MAX_STEPS=6
SUBAGENT_MAX_INVOCATIONS=4
SUBAGENT_MAX_RESULT_CHARS=12000

# 可选：连接本地 Salora Streamable HTTP MCP Server
SALORA_MCP_ENABLED=0
SALORA_MCP_URL=http://127.0.0.1:3000/mcp
SALORA_MCP_TOKEN_HEADER=X-CRM-Authorization
SALORA_MCP_TOKEN=
SALORA_MCP_TIMEOUT=30

